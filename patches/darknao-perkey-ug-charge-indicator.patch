 int zmk_rgb_underglow_toggle(void) {
+#if IS_ENABLED(CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER)
+    /* A low-battery cutoff can remove the rail while desired state remains on. */
+    if (state.on && ext_power != NULL && ext_power_get(ext_power) == 0) {
+        return zmk_rgb_underglow_on();
+    }
+#endif
     return state.on ? zmk_rgb_underglow_off() : zmk_rgb_underglow_on();
 }
 
 #if IS_ENABLED(UNDERGLOW_LAYER_ENABLED)
 
+static struct led_rgb hex_to_rgb(uint8_t r, uint8_t g, uint8_t b);
+
+#define CAPS_LOCK_KEYMAP_INDEX 28
+
+static bool zmk_rgb_underglow_caps_lock_on(void) {
+#if IS_ENABLED(CONFIG_ZMK_HID_INDICATORS)
+    return (zmk_hid_indicators_get_current_profile() & BIT(CAPS_LOCK)) != 0;
+#else
+    return false;
+#endif
+}
+
+static bool zmk_rgb_underglow_apply_caps_lock_indicator(struct led_rgb *target_pixels) {
+    if (!zmk_rgb_underglow_caps_lock_on()) {
+        return false;
+    }
+
+    for (int i = 0; i < STRIP_NUM_PIXELS; i++) {
+        if (rgb_pixel_lookup(i) == CAPS_LOCK_KEYMAP_INDEX) {
+            target_pixels[i] = hex_to_rgb(0xff, 0xff, 0xff);
+            return true;
+        }
+    }
+
+    return false;
+}
+
+static int zmk_rgb_underglow_charge_indicator_color(void) {
+    if (!zmk_usb_is_powered()) {
+        return 0;
+    }
+
+    /* Blue means externally powered when the charger state cannot be read. */
+    int color = 0x0000ff;
+#if DT_HAS_CHOSEN(zmk_battery)
+    struct sensor_value status;
+    if (device_is_ready(battery) &&
+        sensor_sample_fetch_chan(battery, SENSOR_CHAN_NPM1300_CHARGER_STATUS) == 0 &&
+        sensor_channel_get(battery, SENSOR_CHAN_NPM1300_CHARGER_STATUS, &status) == 0) {
+        if (status.val1 & BIT(1)) {
+            /* BCHGCHARGESTATUS.COMPLETED */
+            color = 0x00ff00;
+        } else if (status.val1 & (BIT(2) | BIT(3) | BIT(4))) {
+            /* Trickle, constant-current, or constant-voltage charging. */
+            color = 0xff8000;
+        }
+    }
+#endif
+    return color;
+}
+
 static struct led_rgb hex_to_rgb(uint8_t r, uint8_t g, uint8_t b) {
     uint8_t max = MAX(r, MAX(g, b));
     uint8_t saturated_r = max - ((max - r) * state.color.s) / SAT_MAX;
