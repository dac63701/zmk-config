diff --git a/app/src/rgb_underglow.c b/app/src/rgb_underglow.c
index 865d8ae..406b72a 100644
--- a/app/src/rgb_underglow.c
+++ b/app/src/rgb_underglow.c
@@ -102,11 +102,24 @@ static bool layer_active;
 #endif
 static bool runtime_on;
 static bool auto_suspended;
+static struct k_mutex power_lock;
+
+#define UNDERGLOW_POWER_STABILIZE_MS 5
+#define UNDERGLOW_LATCH_MS 2
 
 #if IS_ENABLED(CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER)
 static const struct device *const ext_power = DEVICE_DT_GET(DT_INST(0, zmk_ext_power_generic));
 #endif
 
+static int zmk_rgb_underglow_clear_strip(void) {
+    static struct led_rgb off_pixels[STRIP_NUM_PIXELS];
+    int err = led_strip_update_rgb(led_strip, off_pixels, STRIP_NUM_PIXELS);
+    if (err < 0) {
+        LOG_ERR("Failed to clear the RGB strip (%d)", err);
+    }
+    return err;
+}
+
 static struct zmk_led_hsb hsb_scale_min_max(struct zmk_led_hsb hsb) {
     hsb.b = CONFIG_ZMK_RGB_UNDERGLOW_BRT_MIN +
             (CONFIG_ZMK_RGB_UNDERGLOW_BRT_MAX - CONFIG_ZMK_RGB_UNDERGLOW_BRT_MIN) * hsb.b / BRT_MAX;
@@ -247,6 +260,10 @@ static void zmk_rgb_underglow_effect_horizontal_rainbow(void) {
 #endif // IS_ENABLED(UNDERGLOW_LAYER_ENABLED)
 
 static void zmk_rgb_underglow_tick(struct k_work *work) {
+    if (!runtime_on) {
+        return;
+    }
+
 #if IS_ENABLED(UNDERGLOW_LAYER_ENABLED)
     zmk_rgb_underglow_set_layer(rgb_underglow_top_layer(), true);
     if (layer_active) {
@@ -274,6 +291,12 @@ static void zmk_rgb_underglow_tick(struct k_work *work) {
 #endif
     }
 
+    /* Off can be requested while this frame is being calculated. Never send
+     * another color frame after the shutdown path has taken ownership. */
+    if (!runtime_on) {
+        return;
+    }
+
     int err = led_strip_update_rgb(led_strip, pixels, STRIP_NUM_PIXELS);
     if (err < 0) {
         LOG_ERR("Failed to update the RGB strip (%d)", err);
@@ -329,6 +352,7 @@ static struct k_work_delayable underglow_save_work;
 
 static int zmk_rgb_underglow_init(void) {
     led_strip = DEVICE_DT_GET(STRIP_CHOSEN);
+    k_mutex_init(&power_lock);
 
 #if IS_ENABLED(CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER)
     if (!device_is_ready(ext_power)) {
@@ -399,6 +423,16 @@ int zmk_rgb_underglow_transient_on(void) {
     if (!led_strip)
         return -ENODEV;
 
+    runtime_on = true;
+    k_mutex_lock(&power_lock, K_FOREVER);
+
+    /* Off may have been requested while this caller waited for a previous
+     * power transition to finish. */
+    if (!runtime_on) {
+        k_mutex_unlock(&power_lock);
+        return 0;
+    }
+
 #if IS_ENABLED(CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER)
     if (ext_power != NULL) {
         int rc = ext_power_enable(ext_power);
@@ -406,9 +440,25 @@ int zmk_rgb_underglow_transient_on(void) {
             LOG_ERR("Unable to enable EXT_POWER: %d", rc);
         }
     }
+
+    /* WS2812 pixels must be fully powered before accepting a data frame. */
+    k_msleep(UNDERGLOW_POWER_STABILIZE_MS);
+    if (!runtime_on) {
+        k_mutex_unlock(&power_lock);
+        return 0;
+    }
 #endif
 
-    runtime_on = true;
+    /* Establish a known all-black latch before painting the requested frame.
+     * This also leaves MOSI low instead of back-powering an unpowered strip. */
+    zmk_rgb_underglow_clear_strip();
+    k_msleep(UNDERGLOW_LATCH_MS);
+
+    if (!runtime_on) {
+        k_mutex_unlock(&power_lock);
+        return 0;
+    }
+
 #if IS_ENABLED(UNDERGLOW_LAYER_ENABLED)
     if (!layer_active) {
         k_timer_start(&underglow_tick, K_NO_WAIT, K_MSEC(ANIMATION_TICK_MS));
@@ -417,28 +467,39 @@ int zmk_rgb_underglow_transient_on(void) {
     k_timer_start(&underglow_tick, K_NO_WAIT, K_MSEC(ANIMATION_TICK_MS));
 #endif
 
+    k_mutex_unlock(&power_lock);
     return 0;
 }
 
 static void zmk_rgb_underglow_off_handler(struct k_work *work) {
+    k_mutex_lock(&power_lock, K_FOREVER);
     if (runtime_on) {
+        k_mutex_unlock(&power_lock);
         return;
     }
 
-    for (int i = 0; i < STRIP_NUM_PIXELS; i++) {
-        pixels[i] = (struct led_rgb){r : 0, g : 0, b : 0};
+#if IS_ENABLED(CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER)
+    /* Do not clock data into an already-unpowered strip; DIN leakage can
+     * partially back-power WS2812 pixels and produce visible flicker. */
+    if (ext_power != NULL && ext_power_get(ext_power) == 0) {
+        k_mutex_unlock(&power_lock);
+        return;
     }
+#endif
 
-    led_strip_update_rgb(led_strip, pixels, STRIP_NUM_PIXELS);
+    zmk_rgb_underglow_clear_strip();
+    k_msleep(UNDERGLOW_LATCH_MS);
 
 #if IS_ENABLED(CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER)
-    if (ext_power != NULL) {
+    if (!runtime_on && ext_power != NULL) {
         int rc = ext_power_disable(ext_power);
         if (rc != 0) {
             LOG_ERR("Unable to disable EXT_POWER: %d", rc);
         }
     }
 #endif
+
+    k_mutex_unlock(&power_lock);
 }
 
 K_WORK_DEFINE(underglow_off_work, zmk_rgb_underglow_off_handler);
